# =====================================================
# waic-getnote-open-debrief · Environment Variables
# =====================================================
# 复制为 .env 并填入真实凭证，.env 已被 .gitignore 排除
# cp .env.example .env

# ----- 得到笔记（getnote）API 凭证 -----
# 由得到团队提供 / 从 getnote App 内抓包获取
GETNOTE_API_BASE=https://api.getnote.com
GETNOTE_API_KEY=your-api-key-here
GETNOTE_USER_TOKEN=your-user-token-here

# ----- CRI（Content Retrieval Interface）配置 -----
# 如果走 CRI 通道而非 HTTP API
CRI_ENABLED=false
CRI_ENDPOINT=
CRI_API_KEY=

# ----- MCP（Model Context Protocol）配置 -----
# 如果通过 MCP server 中转
MCP_ENABLED=false
MCP_SERVER_URL=
MCP_AUTH_TOKEN=

# ----- 限流策略 -----
# 得到笔记 API 的限流阈值（按你实测调整）
RATE_LIMIT_RPS=1                  # 每秒请求数
RATE_LIMIT_BURST=3                # 突发容量
RATE_LIMIT_DAILY_QUOTA=5000       # 每日配额（0 表示无限）

# ----- 断点续传 -----
# 拉取状态会写到 data/interim/_fetch_state.json
FETCH_STATE_PATH=data/interim/_fetch_state.json

# ----- 日志 -----
LOG_LEVEL=INFO
LOG_DIR=logs/